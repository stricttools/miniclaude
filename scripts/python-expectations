#!/usr/bin/env python3
"""Write what the Python miniclaude computes for fixed inputs, as JSON test
data for the Go port's differential tests. Run it with the interpreter that
imports this checkout's miniclaude package (the uv tool install's python):
scripts/python-expectations <generator> <output-file>. The generators are
listed in GENERATORS below."""
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))


def _without_pytest():
    """The test modules hold the fixtures; they import pytest, which the tool
    install lacks, only for decorators, so a stand-in that passes functions
    through is enough to read their data."""
    import types

    if "pytest" in sys.modules:
        return

    class _Mark:
        def __getattr__(self, name):
            return lambda *a, **k: (lambda f: f)

    stub = types.ModuleType("pytest")
    stub.mark = _Mark()
    stub.fixture = lambda *a, **k: (a[0] if a and callable(a[0]) else (lambda f: f))
    sys.modules["pytest"] = stub


def render_fixtures():
    """The renderer test battery, rendered whole at two widths."""
    _without_pytest()
    from miniclaude._render import StreamRenderer
    from tests.test_render import FIXTURES

    cases = []
    for name, segments in FIXTURES.items():
        for width in (80, 24):
            r = StreamRenderer(width)
            out = []
            for kind, text in segments:
                out.append(r.feed_text(text) if kind == "text" else r.feed_thinking(text))
            out.append(r.finish())
            cases.append({"name": name, "width": width, "segments": segments, "output": "".join(out)})
    return cases


def _record(module_names, targets):
    """Run the named test modules with each target function wrapped so every
    call's arguments and result are recorded; targets maps a function name
    to the module that defines it."""
    import asyncio
    import importlib
    import inspect

    _without_pytest()
    calls = []
    modules = [importlib.import_module(m) for m in module_names]
    originals = {}
    for name, owner in targets.items():
        mod = importlib.import_module(owner)
        real = getattr(mod, name)
        originals[name] = (mod, real)

        def wrapper(*args, _name=name, _real=real, **kwargs):
            result = _real(*args, **kwargs)
            calls.append({"fn": _name, "args": _plain(args), "kwargs": _plain(kwargs), "result": _plain(result)})
            return result

        setattr(mod, name, wrapper)
        for m in modules:
            if getattr(m, name, None) is real:
                setattr(m, name, wrapper)
    try:
        for m in modules:
            for attr, value in list(vars(m).items()):
                if attr.startswith("test_") and callable(value):
                    params = inspect.signature(value).parameters
                    if params:
                        continue
                    try:
                        out = value()
                        if inspect.iscoroutine(out):
                            asyncio.run(out)
                    except Exception as exc:  # noqa: BLE001 -- stale assertions do not stop the recording
                        print(f"{m.__name__}.{attr}: {type(exc).__name__}: {exc}", file=sys.stderr)
    finally:
        for name, (mod, real) in originals.items():
            setattr(mod, name, real)
    return calls


def _plain(value):
    """value as JSON-ready data: dataclasses and namespaces become dicts."""
    import dataclasses
    from types import SimpleNamespace

    if dataclasses.is_dataclass(value) and not isinstance(value, type):
        return {k: _plain(v) for k, v in dataclasses.asdict(value).items()}
    if isinstance(value, SimpleNamespace):
        return {k: _plain(v) for k, v in vars(value).items()}
    if isinstance(value, dict):
        return {str(k): _plain(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [_plain(v) for v in value]
    if value is None or isinstance(value, (str, int, float, bool)):
        return value
    return repr(value)


def toolline_calls():
    """Every format_tool_use and format_tool_result call of test_toolline."""
    return _record(["tests.test_toolline"], {
        "format_tool_use": "miniclaude._toolline",
        "format_tool_result": "miniclaude._toolline",
    })


def dialog_calls():
    """Every call of the pure dialog builders the dialog tests make."""
    return _record(["tests.test_dialogs"], {
        "suggestion_label": "miniclaude._dialogs",
        "build_permission_choices": "miniclaude._dialogs",
        "build_decision_surface": "miniclaude._dialogs",
        "build_question_answers": "miniclaude._dialogs",
        "parse_multiselect": "miniclaude._dialogs",
    })


GENERATORS = {
    "render-fixtures": render_fixtures,
    "toolline-calls": toolline_calls,
    "dialog-calls": dialog_calls,
}

if len(sys.argv) != 3 or sys.argv[1] not in GENERATORS:
    sys.exit("usage: scripts/python-expectations <%s> <output-file>" % "|".join(GENERATORS))
out = Path(sys.argv[2])
out.parent.mkdir(parents=True, exist_ok=True)
out.write_text(json.dumps(GENERATORS[sys.argv[1]](), indent=2, ensure_ascii=True) + "\n")
print(out)
